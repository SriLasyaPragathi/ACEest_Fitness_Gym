# ACEest Fitness API - Environment Configuration Template
# Copy this file to .env and fill in your values

# ============ Flask Configuration ============
FLASK_APP=app.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production

# ============ Server Configuration ============
HOST=0.0.0.0
PORT=5000

# ============ Database Configuration ============
DATABASE_PATH=./aceest_fitness.db
DATABASE_BACKUP_PATH=./backups/

# ============ Security Configuration ============
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
API_KEY_REQUIRED=False

# ============ Session Configuration ============
SESSION_TIMEOUT=3600
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256

# ============ Logging Configuration ============
LOG_LEVEL=INFO
LOG_FILE=logs/aceest.log
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s

# ============ Email Configuration ============
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_USE_TLS=True
MAIL_FROM_ADDRESS=noreply@aceest.com

# ============ Performance Configuration ============
MAX_CONNECTIONS=100
CONNECTION_TIMEOUT=30
QUERY_TIMEOUT=60

# ============ Development Tools ============
IPYTHON=True
DEBUGGER=True

# ============ Monitoring & Metrics ============
ENABLE_METRICS=True
METRICS_INTERVAL=60

# ============ Feature Flags ============
FEATURE_PDF_REPORTS=True
FEATURE_AI_PROGRAMS=True
FEATURE_BULK_OPERATIONS=False

# ============ Third-party Integrations ============
# Sentry error tracking
SENTRY_DSN=

# DataDog monitoring
DATADOG_API_KEY=

# Firebase/Analytics
FIREBASE_PROJECT_ID=

# ============ Cache Configuration ============
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# ============ Rate Limiting ============
RATELIMIT_ENABLED=False
RATELIMIT_STORAGE_URL=memory://
RATELIMIT_DEFAULT=100 per hour

# ============ Production Settings ============
# Only set these for production
PRODUCTION=False
ENABLE_HTTPS=False
CERTIFICATE_PATH=/etc/ssl/certs/
PRIVATE_KEY_PATH=/etc/ssl/private/

# ============ Testing Configuration ============
TESTING=False
TEST_DATABASE_PATH=./test_aceest.db
